{
  "uid": "qa-shop-overview",
  "title": "QA Shop — обзор",
  "tags": ["qa-shop", "e2e"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Заказы за 1 ч",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(increase(shop_orders_total[1h]))", "legendFormat": "заказы", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 2,
      "title": "Выручка за 1 ч",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyRUB" }, "overrides": [] },
      "targets": [{ "expr": "increase(shop_revenue_rub_total[1h])", "legendFormat": "выручка", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 3,
      "title": "Добавлений в корзину за 1 ч",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "increase(shop_cart_items_added_total[1h])", "legendFormat": "товары", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 4,
      "title": "Регистраций за 1 ч",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "increase(shop_users_registered_total[1h])", "legendFormat": "регистрации", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 5,
      "title": "Неудачных входов за 1 ч",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "increase(shop_login_failures_total[1h])", "legendFormat": "ошибки", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 6,
      "title": "RPS всего",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='qa-shop'}[1m]))", "legendFormat": "rps", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 7,
      "title": "HTTP RPS по маршрутам",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 4, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "sum by (route) (rate(http_requests_total{job='qa-shop',route!='/metrics'}[1m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 8,
      "title": "Latency p95 / p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job='qa-shop'}[1m])))", "legendFormat": "p95", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job='qa-shop'}[1m])))", "legendFormat": "p99", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "title": "Доля ошибок 4xx/5xx",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{job='qa-shop',status=~'4..|5..'}[1m])) / clamp_min(sum(rate(http_requests_total{job='qa-shop'}[1m])), 1)", "legendFormat": "errors %", "refId": "A" }]
    },
    {
      "id": 10,
      "title": "Активные сессии",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "shop_active_sessions", "legendFormat": "сессии", "refId": "A" }]
    },
    {
      "id": 11,
      "title": "Товары без остатка",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "shop_products_out_of_stock", "legendFormat": "нет в наличии", "refId": "A" }]
    },
    {
      "id": 12,
      "title": "Заказы по способу доставки (1 ч)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "sum by (delivery) (increase(shop_orders_total[1h]))", "legendFormat": "{{delivery}}", "refId": "A" }]
    },
    {
      "id": 13,
      "title": "Event loop lag p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "lag", "refId": "A" }]
    },
    {
      "id": 14,
      "title": "Heap / RSS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "nodejs_heap_size_used_bytes", "legendFormat": "heap", "refId": "A" },
        { "expr": "process_resident_memory_bytes{job='qa-shop'}", "legendFormat": "RSS", "refId": "B" }
      ]
    },
    {
      "id": 15,
      "title": "CPU процесса",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job='qa-shop'}[1m])", "legendFormat": "CPU", "refId": "A" }]
    }
  ]
}
